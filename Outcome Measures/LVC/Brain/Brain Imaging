/******************************************************************************** 
Low Value brain scans

Program description: This file calculates the spending on and prevalence of low value brain scan
testing in the commercial APCD

Files in (what files are being used in this program):
	- "Z:\Current projects\LVC\2019\Processed\lvc_medclm_$pre_year$year.dta"

Files out (what files - if any - are you creating in this program):
	- "$processed\brain.dta" 
	
Analyst: JK building on  HOJ work

********************************************************************************/
use "$processed\lvc_medclm_$pre_year$year", clear

*Add date variable
	gen month=month(dateofservicefrom)
	gen day=day(dateofservicefrom)
	gen year=year(dateofservicefrom)
	gen numdate=mdy(month, day, year)
	
keep if age >= 18 & age != .

gen syncope = 0
forvalues x= 1/7 {
replace syncope = 1 if substr(icd`x', 1, 3) == "R55"
}
*syncope

gen brain= 0
replace brain = 1 if procedurecode == "70450" | procedurecode == "70460" | procedurecode == "70470"
replace brain = 1 if procedurecode == "70551"
replace brain = 1 if procedurecode == "70552"
replace brain = 1 if procedurecode == "70553"
replace brain = 1 if procedurecode == "70554"
replace brain = 1 if procedurecode == "70555"
replace brain = 1 if procedurecode == "70556"
replace brain = 1 if procedurecode == "70557"
replace brain = 1 if procedurecode == "70558"
replace brain = 1 if procedurecode == "70559"
*brain imagining

*DEFINE DENOMINATOR [those with brain scans]
	
	gen braindate=numdate if brain == 1
	
	egen personinclude=sum(syncope) if APCDyear == $year, by(memberlinkeid)
	drop if personinclude == 0

gen exclude_brain = 0	
	
gen inpatient =0
replace inpatient = 1 if claimcat == "INP"
replace inpatient = 1 if siteofservice == 21
replace inpatient = 1 if siteofservice == 31
replace inpatient = 1 if siteofservice == 51
replace inpatient = 1 if siteofservice == 61
*inpatient

	gen inpatientdate=numdate if inpatient==1
	
	*browse memberlinkeid braindate diagnosisdate numdate
	
	*drop brain scans that aren't within 1 year of competing diagnosis
	gen mostrecentinpatientdate=inpatientdate
	gsort +memberlinkeid +numdate +inpatientdate
	*fill claims for competing diagnosis visits with the date of the previous competing diagnosis visit for that patient 
	*mostrecentdiagdate stays missing if there are no hypothyroidism visits before that claim
	replace mostrecentinpatientdate=mostrecentinpatientdate[_n-1] if (mostrecentinpatientdate==. & memberlinkeid[_n]==memberlinkeid[_n-1])
	*icdtocpt is number of days between diagnosis and brain scan. Should always be positive because mostrecentdiagdate is the previous competing diagnosis and is missing if there are no previous diagnoses
	gen inpatient_interval = braindate - mostrecentinpatientdate
	
	tab inpatient_interval
	
	replace exclude_brain = 1 if inpatient_interval > -1 & inpatient_interval < 31

gen ichem = 0
forvalues x = 1/7 {
replace ichem = 1 if substr(icd`x', 1, 3) == "I62"
}
*intracranial hemorrage

gen stroke = 0
forvalues x = 1/7 {
replace stroke = 1 if substr(icd`x', 1, 3) == "I63"
replace stroke = 1 if substr(icd`x', 1, 4) == "G459"
replace stroke = 1 if substr(icd`x', 1, 4) == "I693"
replace stroke = 1 if substr(icd`x', 1, 5) == "Z8673"
}
*

gen compdi = 0
replace compdi = 1 if stroke == 1 | ichem == 1
	
	gen compdidate=numdate if compdi==1
	
	*browse memberlinkeid braindate diagnosisdate numdate
	
	*drop brain scans that aren't within 1 year of competing diagnosis
	gen mostrecentcompdidate=compdidate
	gsort +memberlinkeid +numdate +compdidate
	*fill claims for competing diagnosis visits with the date of the previous competing diagnosis visit for that patient 
	*mostrecentdiagdate stays missing if there are no hypothyroidism visits before that claim
	replace mostrecentcompdidate=mostrecentcompdidate[_n-1] if (mostrecentcompdidate==. & memberlinkeid[_n]==memberlinkeid[_n-1])
	*icdtocpt is number of days between diagnosis and brain scan. Should always be positive because mostrecentdiagdate is the previous competing diagnosis and is missing if there are no previous diagnoses
	gen compdi_interval = braindate - mostrecentcompdidate
	
	tab compdi_interval
	
	replace exclude_brain = 1 if compdi_interval > -1 & compdi_interval < 91
	*excluding if competing diagnoses are found
	
gen tumor = 0
forvalues x = 1/7 {
replace tumor = 1 if substr(icd`x', 1, 3) == "C71"
replace tumor = 1 if substr(icd`x', 1, 4) == "D330"
replace tumor = 1 if substr(icd`x', 1, 4) == "D331"
replace tumor = 1 if substr(icd`x', 1, 4) == "D332"
replace tumor = 1 if substr(icd`x', 1, 4) == "D333"
replace tumor = 1 if substr(icd`x', 1, 4) == "C760"
replace tumor = 1 if substr(icd`x', 1, 4) == "D234"
replace tumor = 1 if substr(icd`x', 1, 4) == "D233"
replace tumor = 1 if substr(icd`x', 1, 5) == "D3611"
}
*

	gen tumordate=numdate if tumor==1
	
	*browse memberlinkeid braindate diagnosisdate numdate
	
	*drop brain scans that aren't within 1 year of competing diagnosis
	gen mostrecenttumordate=tumordate
	gsort +memberlinkeid +numdate +tumordate
	*fill claims for competing diagnosis visits with the date of the previous competing diagnosis visit for that patient 
	*mostrecentdiagdate stays missing if there are no hypothyroidism visits before that claim
	replace mostrecenttumordate=mostrecenttumordate[_n-1] if (mostrecenttumordate==. & memberlinkeid[_n]==memberlinkeid[_n-1])
	*icdtocpt is number of days between diagnosis and brain scan. Should always be positive because mostrecentdiagdate is the previous competing diagnosis and is missing if there are no previous diagnoses
	gen tumor_interval = braindate - mostrecenttumordate
	
	tab tumor_interval
	
	replace exclude_brain = 1 if tumor_interval > -1 & tumor_interval != .
	*excluding if competing diagnoses are found
	

gen head = 0
forvalues x = 1/7 {
replace head = 1 if substr(icd`x', 1, 2) == "S0"
}
* head injury

	gen headdate=numdate if head==1
	
	*browse memberlinkeid braindate diagnosisdate numdate
	
	*drop brain scans that aren't within 1 year of competing diagnosis
	gen mostrecentheaddate=headdate
	gsort +memberlinkeid +numdate +headdate
	*fill claims for competing diagnosis visits with the date of the previous competing diagnosis visit for that patient 
	*mostrecentdiagdate stays missing if there are no hypothyroidism visits before that claim
	replace mostrecentheaddate=mostrecentheaddate[_n-1] if (mostrecentheaddate==. & memberlinkeid[_n]==memberlinkeid[_n-1])
	*icdtocpt is number of days between diagnosis and brain scan. Should always be positive because mostrecentdiagdate is the previous competing diagnosis and is missing if there are no previous diagnoses
	gen head_interval = braindate - mostrecentheaddate
	
	tab head_interval
	
	replace exclude_brain = 1 if head_interval > -1 & head_interval < 8
	*excluding if competing diagnoses are found
	
	

	egen personexclude=sum(exclude_brain), by(memberlinkeid)
	drop if personexclude != 0
	*removing exclusions
	
	* save intermediate file with denom
		save "$processed\denom_brain_$year.dta", replace
	
	*Count number of encounters in $year 
	egen denom_encountergroup = group(memberlinkeid numdate procedurecode) if APCDyear==$year & brain == 1
	egen denom_encounter = tag(denom_encountergroup) if APCDyear==$year
	tab denom_encounter	// 601,186
	
	*Count number of individuals with 
	egen denom_members = tag(memberlinkeid) if APCDyear==$year
	tab denom_members // 30,438
	
*DEFINE NUMERATOR [Valid brain scan without competing diagnoses]
	
	* Time interval for brain scans to determine starting population
	gen syndate=numdate if syncope==1
	
	browse memberlinkeid braindate syndate numdate
	
	*drop brain scans that aren't within 30 days of syncope date
	gen mostrecentsyndate=syndate
	gsort +memberlinkeid +numdate +syndate
	*fill claims with previous
	replace mostrecentsyndate=mostrecentsyndate[_n-1] if (mostrecentsyndate==. & memberlinkeid[_n]==memberlinkeid[_n-1])
	*interval is number of days between diagnosis and brain scan. Should always be positive 
	gen interval = braindate - mostrecentsyndate
	
	tab interval
	gen byte denom_brain = 0

gen byte num_brain = .
replace num_brain = 1 if interval > -31 & interval < 31

gen def = 0
forvalues x = 1/7 {
replace def = 1 if substr(icd`x', 1, 4) == "R298"
replace def = 1 if substr(icd`x', 1, 4) == "R299"	
}
*

*neurological deficit

*in the above lines, we remove claim lines with associated diagnoses for neurological deficit
	
	gen defdate=numdate if def==1
	
	*browse memberlinkeid braindate diagnosisdate numdate
	
	*drop brain scans that aren't within 1 year of competing diagnosis
	gen mostrecentdefdate=defdate
	gsort +memberlinkeid +numdate +defdate
	*fill claims for competing diagnosis visits with the date of the previous competing diagnosis visit for that patient 
	*mostrecentdiagdate stays missing if there are no hypothyroidism visits before that claim
	replace mostrecentdefdate=mostrecentdefdate[_n-1] if (mostrecentdefdate==. & memberlinkeid[_n]==memberlinkeid[_n-1])
	*icdtocpt is number of days between diagnosis and brain scan. Should always be positive because mostrecentdiagdate is the previous competing diagnosis and is missing if there are no previous diagnoses
	gen def_interval = braindate - mostrecentdefdate
	
	tab def_interval
	
	gen num_include=1 if num_brain==1
	
	gen not_waste = 0
	replace not_waste=1 if def_interval > -1 & def_interval < 31
	egen total_not_waste=sum(not_waste), by(memberlinkeid)
	replace num_include = 0 if not_waste != 0
	*defining those as not wasteful from numerator


*COUNT CLAIM LINES, ENCOUNTERS, MEMBERS
*for brain, claim lines encounters and patients are all the same because we only count the first brain scan test for each member
	
	*generate variable for $year brain scan
	gen num_$year = num_include if APCDyear==$year
	
	*count number of injection encounters (same member same date)
	egen brain_encounter = group(memberlinkeid numdate) if num_$year==1
	egen num_encounter = tag(brain_encounter) if num_$year==1
	tab num_encounter
	
	*count number of distinct injections (same member same date same procedure code)
	egen proced_encounter = group(memberlinkeid numdate procedurecode) if num_$year==1
			
	egen unique_proced_encounter = tag(proced_encounter)
	tab unique_proced_encounter
		
	*count number of individuals with low value injections
	egen unique_num = tag(memberlinkeid) if num_$year == 1
	tab unique_num
	
	*count number of distinct injections (same member same date same procedurecode) per individual
	egen brain_count = sum(unique_proced_encounter), by(memberlinkeid)
	gen unique_brain_count = brain_count if unique_num==1
	tab unique_brain_count
	
	*count number of distinct injections (same member same date same procedurecode)
	*per encounter (same date same member)
	egen brainencounter_count = sum(unique_proced_encounter), by(brain_encounter)
	gen unique_brainencounter_count = brainencounter_count if num_encounter ==1
	tab unique_brainencounter_count
	
*CALCULATE SPENDING
	
	*calculate spending for price_include ==1
	egen lvcspend=sum(spending) if price_include==1 & num_$year==1
	egen lvccostshare=sum(costsharing) if price_include==1 & num_$year==1
	
	tab lvcspend
	tab lvccostshare
	
	*calculate spending for price_include ==0 (replace with median)
	sum spending if price_include==1 & num_$year==1, d
	gen median_spending=r(p50)
	gen imputedspending=spending if num_$year==1
	replace imputedspending=median_spending if (spending==0 | price_include==0) & num_$year==1
	
	sum costsharing if price_include==1 & num_$year==1, d
	gen median_costsharing=r(p50)
	gen imputedcostsharing = costsharing if num_$year==1
	replace imputedcostsharing=median_costsharing if (costsharing ==0 | price_include==0) & num_$year==1
	
	egen lvcspend2=sum(imputedspending)
	egen lvccostshare2=sum(imputedcostsharing)
	
	tab lvcspend2
	tab lvccostshare2
	
	gen num_priceinclude = price_include if num_$year==1
	
*UNADJUSTED 
	merge m:1 memberlinkeid using "$memeligxwalk/memberxwalk_$year", keep(master match) keepusing(outof12 organization_for_reg)
	
	* save intermediate file
		save "$processed\brain_clmlevel_$year.dta", replace

use "$processed\brain_clmlevel_$year.dta", clear
collapse (sum) denom_members denom_encounter num_$year num_encounter unique_proced_encounter unique_num imputedspending imputedcostsharing num_priceinclude
order denom_members denom_encounter num_$year num_encounter unique_proced_encounter unique_num imputedspending imputedcostsharing num_priceinclude
export excel using "$results/LVC_ind_$year.xlsx", sheet("brain") cell(A4) firstrow(variables) sheetreplace

